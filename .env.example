# ── 内容管线（DP·AI，仅服务端，绝不进入前端代码）─────────────
DP_API_KEY=                        # DP API Key（OpenAI 兼容接口，与恒矽同套配置）
DP_API_BASE=https://api.deepseek.com
DP_MODEL=deepseek-chat

